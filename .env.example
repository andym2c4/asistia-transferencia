# Solo para esta instalación local nueva. No contiene credenciales operativas.
ASISTIA_DATABASE_URL=postgresql://asistia:asistia_dev@127.0.0.1:5554/asistia_dev
ASISTIA_WEB_STORAGE=data/web
ASISTIA_WEB_HOSTS=localhost,127.0.0.1,[::1]
ASISTIA_WEB_HTTPS=0
ASISTIA_WEB_DEVELOPMENT_EXPORTS=1
ASISTIA_WEB_DEVELOPMENT_TOOLS=1
# Generar la clave con: uv run asistia web crear-clave
ASISTIA_GEMINI_KEYS=
ASISTIA_GEMINI_ENV_FILE=.env
ASISTIA_X2T=data/runtime/onlyoffice/converter/x2t
ASISTIA_ONLYOFFICE_FONTS=data/runtime/onlyoffice/fonts
# pytest lee esta variable del PROCESO, no del archivo .env.
# ASISTIA_TEST_DATABASE_URL=postgresql://asistia:asistia_test@127.0.0.1:5555/asistia_test_transferencia
